# Weather station freiapi 04 192.168.10.171 (shelf in front of the control room)
#
record(ai, "Env-FREIA:PT001:sRdV") {
   field (DESC, "Atmospheric pressure")
   field (EGU, "mbar")
   field (DTYP, "stream")
   field (LOPR, "900")
   field (HOPR, "1100.0")
   field (PREC, "1")
   field (INP, "@weather.proto get_pressure $(PORT)")
   field (SCAN, "10 second")
}

record(ai, "Env-FREIA:TT001:sRdV") {
   field (DESC, "Ambient temperature")
   field (EGU, "ᵒC")
   field (DTYP, "stream")
   field (LOPR, "10")
   field (HOPR, "30.0")
   field (PREC, "1")
   field (INP, "@weather.proto get_pressuret $(PORT)")
   field (SCAN, "10 second")
}

record(ai, "Env-FREIA:TT002:sRdV") {
   field (DESC, "Ambient temperature")
   field (EGU, "ᵒC")
   field (DTYP, "stream")
   field (LOPR, "10")
   field (HOPR, "30.0")
   field (PREC, "1")
   field (INP, "@weather.proto get_humidityt $(PORT)")
   field (SCAN, "10 second")
}

record(ai, "Env-FREIA:HT002:sRdV") {
   field (DESC, "Ambient relative humidity")
   field (EGU, "%")
   field (DTYP, "stream")
   field (LOPR, "0")
   field (HOPR, "100.0")
   field (PREC, "1")
   field (INP, "@weather.proto get_humidity $(PORT)")
   field (SCAN, "10 second")
}
